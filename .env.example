# Copy to .env (never commit .env). Backend reads ../.env or backend/.env.

# --- Agora (console.agora.io) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_AREA=US               # REST gateway region nearest the backend: US, EU or AP
# No Customer ID/Secret needed: the official agora-agents SDK signs REST calls with the App Certificate.

# Public HTTPS URL Agora's cloud can reach.
# Production: your Railway backend domain. Dev: an ngrok / cloudflared tunnel to localhost:8000.
PUBLIC_BACKEND_URL=

# --- LLM: any OpenAI-compatible provider (default: Gemini's OpenAI endpoint) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001   # for RAG
LLM_REASONING_EFFORT=       # optional; Gemini is sent "low" when this is empty so a reply is not swallowed by thinking

# Secret Agora sends to our /v1/chat/completions. Set it in production so it survives restarts.
AGENT_LLM_KEY=

# --- Murf Falcon TTS ---
MURF_API_KEY=
MURF_REGION_URL=https://global.api.murf.ai
MURF_MODEL=falcon-2.1
MURF_AGENT_VOICE=           # optional pin; leave empty to pick a voice that speaks English, Hindi and Tamil

# --- MCP enterprise tool server ---
MCP_ENTERPRISE_URL=http://localhost:8101/mcp

# --- Optional: Jira Cloud sync for repair jobs (read by the MCP server). Leave empty to skip Jira. ---
JIRA_SITE=                  # e.g. https://your-team.atlassian.net
JIRA_EMAIL=                 # the Atlassian account the API token belongs to
JIRA_API_TOKEN=             # id.atlassian.com -> Security -> API tokens
JIRA_PROJECT=               # project key, e.g. EAR
JIRA_ISSUE_TYPE=Task

# Browser origins allowed to call the backend (comma-separated). Add your Vercel domain in production.
CORS_ORIGINS=http://localhost:5173

DEFAULT_PACK=manufacturing  # or railways
STORE_DIR=store             # baselines, clips, cases, generated audio (use a volume path on Railway)

# true = no external voice; text box + browser audio, for offline dev
DEMO_MODE=false
