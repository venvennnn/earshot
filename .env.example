# Copy to .env (never commit .env). Backend reads ../.env or backend/.env.

# --- Agora (console.agora.io) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=          # REST API Basic auth
AGORA_CUSTOMER_SECRET=

# Public HTTPS URL Agora's cloud can reach.
# Production: your Railway backend domain. Dev: an ngrok / cloudflared tunnel to localhost:8000.
PUBLIC_BACKEND_URL=

# --- LLM: any OpenAI-compatible provider (default: Gemini's OpenAI endpoint) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001   # for RAG

# --- Murf Falcon TTS ---
MURF_API_KEY=
MURF_REGION_URL=https://global.api.murf.ai

# --- MCP enterprise tool server ---
MCP_ENTERPRISE_URL=http://localhost:8101/mcp

# Browser origins allowed to call the backend (comma-separated). Add your Vercel domain in production.
CORS_ORIGINS=http://localhost:5173

# true = no external voice; text box + browser audio, for offline dev
DEMO_MODE=false
